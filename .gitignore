c.txt

# === 临时编译/测试目录（含本机路径泄漏风险）===
.tmp_test/
.whale-snapshots/

# === 一次性 Python 批处理脚本（含本机路径，不提交）===
replace_batch*.py
replace_group*.py
replace_groups*.py
scan_*.py
_fix_test.py
add.py

# === Trae IDE 内部数据（个人记忆，不提交）===
